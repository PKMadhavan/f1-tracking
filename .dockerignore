.git/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/

# Editor / OS cruft
.DS_Store
.vscode/
.idea/

# Docker itself
Dockerfile
.dockerignore
